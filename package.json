{
  "name": "vegam-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Vegam (வேகம்) — World-Class Open-Source Event Simulation & Surprisal Intelligence Platform",
  "author": "Vegam Core Team",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules packages/*/node_modules packages/*/dist",
    "studio": "pnpm --filter @vegam/studio dev",
    "studio:prod": "pnpm --filter @vegam/studio start",
    "engine:dev": "pnpm --filter @vegam/engine dev",
    "cli": "pnpm --filter @vegam/cli start"
  },
  "devDependencies": {
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "rimraf": "^6.0.1",
    "@types/node": "^26.6.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
