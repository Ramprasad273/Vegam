{
  "name": "@vegam/templates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pre-built production-ready simulation templates and scenarios for Vegam",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rimraf dist",
    "test": "node --test \"dist/__tests__/**/*.test.js\"",
    "type-check": "tsc --noEmit"
  },

  "dependencies": {
    "@vegam/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.8.1"
  }
}
