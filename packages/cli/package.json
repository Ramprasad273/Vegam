{
  "name": "@vegam/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Terminal CLI binary for Vegam headless execution, CI/CD pipelines, and SARIF/JUnit export",
  "bin": {
    "vegam": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b && node -e \"import('fs').then(fs => fs.chmodSync('dist/cli.js', '755'))\"",
    "dev": "tsc -b --watch",
    "clean": "rimraf dist",
    "test": "node --test \"dist/__tests__/**/*.test.js\"",
    "type-check": "tsc --noEmit"
  },

  "dependencies": {
    "@vegam/engine": "workspace:*",
    "@vegam/connectors": "workspace:*",
    "@vegam/templates": "workspace:*",
    "commander": "^15.0.0",
    "kleur": "^4.1.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.4.0"
  }
}
