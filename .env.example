# Environment Variables for Vegam Local Development
#
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.

# RabbitMQ credentials for docker-compose.dev.yml
RABBITMQ_USER=vegam
RABBITMQ_PASSWORD=change_me_before_use

# Governor: set to true in hosted (Railway/Render) deployments, false for local Docker dev.
VEGAM_GOVERNOR_ENABLED=true

# Secret token required to access GET /api/test-runner in hosted mode.
# Generate a strong random string: openssl rand -hex 32
VEGAM_HEALTH_TOKEN=replace_with_a_32_char_random_secret

# Enable/disable live engine test-runner endpoint (defaults to false in hosted tier for security)
VEGAM_TEST_RUNNER_ENABLED=false
